---
interface Props { name: 'basketball' | 'gaming' | 'friends' | 'arrow' | 'github' | 'linkedin' }
const { name } = Astro.props;
---
<svg class={`icon icon-${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'basketball' && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3v18M5.6 5.6c3.4 3.2 3.4 9.6 0 12.8M18.4 5.6c-3.4 3.2-3.4 9.6 0 12.8" /></>)}
  {name === 'gaming' && (<><rect x="2.5" y="7" width="19" height="11" rx="5.5" /><path d="M7.5 10.5v4M5.5 12.5h4" /><circle cx="15.5" cy="11.5" r=".9" fill="currentColor" /><circle cx="17.5" cy="13.8" r=".9" fill="currentColor" /></>)}
  {name === 'friends' && (<><circle cx="9" cy="8" r="3.2" /><circle cx="17" cy="9.5" r="2.5" /><path d="M3 19c.6-3.4 3-5.3 6-5.3s5.4 1.9 6 5.3M15.2 14.3c2.6-.3 4.8 1.2 5.6 4.2" /></>)}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'github' && <path d="M9 19c-4 1.3-4-2-6-2.5m12 4.5v-3.5a3 3 0 0 0-.9-2.4c3-.3 6.1-1.5 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.1-.3-3.7 1.4a12.6 12.6 0 0 0-6.6 0C5.8 1.8 4.7 2.2 4.7 2.2a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.1 3.1 6.3 6.1 6.6a3 3 0 0 0-.9 2.4V21" />}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.2v.1M12 17v-3.8a2.3 2.3 0 0 1 4.6 0V17M12 10.5V17" /></>)}
</svg>
